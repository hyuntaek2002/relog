# 운영용 값 예시. 이 파일을 .env로 복사한 뒤 바꾼다. .env는 저장소에 올리지 않는다.
RELOG_DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
# 웹이 열리는 주소(쉼표로 여러 개). GitHub Pages는 경로 없이 호스트까지만 적는다.
RELOG_CORS_ORIGINS=https://hyuntaek2002.github.io
# 서버를 직접 노출할 때만 0.0.0.0 으로 바꾼다. 기본은 같은 기계에서만 접근(앞단 프록시 사용).
RELOG_BIND=127.0.0.1
RELOG_PORT=8080
# HTTPS 앞단(Caddy, --profile tls)을 쓸 때의 도메인
RELOG_DOMAIN=api.example.com
